{
  "name": "sdpm-orchestrator",
  "description": "Presentation orchestrator. Builds a deck from material or dialogue and delegates slide generation to composer agents.",
  "mcpServers": {
    "sdpm": {
      "command": "uv",
      "args": [
        "run",
        "python",
        "server_acp.py"
      ],
      "timeout": 120000
    }
  },
  "prompt": "file://../acp-agents/prompts/orchestrator.md",
  "tools": [
    "@sdpm/analyze_template",
    "@sdpm/apply_style",
    "@sdpm/arch_diagram",
    "@sdpm/check_specs",
    "@sdpm/code_to_slide",
    "@sdpm/generate_pptx",
    "@sdpm/grid",
    "@sdpm/hearing",
    "@sdpm/import_attachment",
    "@sdpm/init_deck_workspace",
    "@sdpm/list_styles",
    "@sdpm/list_templates",
    "@sdpm/read_attachment",
    "@sdpm/read_guides",
    "@sdpm/run_python",
    "@sdpm/search_assets",
    "@sdpm/start_presentation",
    "@sdpm/start_translation",
    "use_subagent",
    "read",
    "glob",
    "grep",
    "web_search",
    "web_fetch"
  ],
  "allowedTools": [
    "@sdpm/analyze_template",
    "@sdpm/apply_style",
    "@sdpm/arch_diagram",
    "@sdpm/check_specs",
    "@sdpm/code_to_slide",
    "@sdpm/generate_pptx",
    "@sdpm/grid",
    "@sdpm/hearing",
    "@sdpm/import_attachment",
    "@sdpm/init_deck_workspace",
    "@sdpm/list_styles",
    "@sdpm/list_templates",
    "@sdpm/read_attachment",
    "@sdpm/read_guides",
    "@sdpm/run_python",
    "@sdpm/search_assets",
    "@sdpm/start_presentation",
    "@sdpm/start_translation",
    "use_subagent",
    "read",
    "glob",
    "grep",
    "web_search",
    "web_fetch"
  ],
  "toolsSettings": {
    "subagent": {
      "availableAgents": [
        "sdpm-composer"
      ],
      "trustedAgents": [
        "sdpm-composer"
      ]
    }
  },
  "welcomeMessage": "Drop material or describe what you want to present.",
  "resources": []
}
